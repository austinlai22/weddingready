# Copy to .env.local for local development. On Vercel, set these in Project → Settings → Environment Variables.

# --- AI (server only, never sent to the browser) ---
# Claude answers when this key has API credits. Without it (or with no credits), Gemini answers if GEMINI_API_KEY is set.
ANTHROPIC_API_KEY=
# Google Gemini API free tier: key from https://aistudio.google.com/apikey. Free, but Google may use requests to improve its products.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.6-flash
# Optional model override; the spec's model is the default.
# AI_MODEL=claude-sonnet-5-5
# Daily spend cap across all users, in USD. When reached, AI routes return 503 and the app falls back to manual entry.
AI_DAILY_BUDGET_USD=2

# --- Rate limits + spend tracking (Upstash Redis). Either naming works. Without these, an in-memory store is used (fine locally, not on Vercel). ---
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# Secret for hashing device IDs and IP addresses in rate-limit keys. Any long random string.
RATE_LIMIT_SECRET=

# --- Analytics (PostHog, anonymous). Leave blank to turn analytics off. ---
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# --- Scripts only ---
# FDC_API_KEY=            # optional for npm run foods:verify (bulk download is used without it)
# POSTHOG_PERSONAL_API_KEY=
# POSTHOG_PROJECT_ID=
# POSTHOG_HOST=https://us.posthog.com
